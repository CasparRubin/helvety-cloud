# Copy to .env.local in this directory for local Next.js (never commit secrets).

NEXT_PUBLIC_SUPABASE_URL=https://qnoeiurmyyyuawkcifmw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service / secret key (sb_secret_… or legacy service_role JWT): webhook + discount redeem only.
SUPABASE_SERVICE_ROLE_KEY=

# App origin for Stripe redirect URLs (Checkout success/cancel, Portal return).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# P6f / P12 billing (server-only; never expose with NEXT_PUBLIC_).
# Stripe never receives vault keys or vault content — billing metadata only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prefer yearly Pro price; monthly kept as legacy fallback.
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
# À-la-carte addon pack Prices (same billing interval as Pro).
STRIPE_PRICE_ADDON_PROJECTS=
STRIPE_PRICE_ADDON_TASKS=
STRIPE_PRICE_ADDON_NOTES=
STRIPE_PRICE_ADDON_CONTACTS=
STRIPE_PRICE_ADDON_MEMBERS=
STRIPE_PRICE_ADDON_STORAGE=
STRIPE_PRICE_ADDON_FILES_PER_TASK=

