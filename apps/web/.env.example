# Copy to .env.local in this directory for local Next.js (never commit secrets).

NEXT_PUBLIC_SUPABASE_URL=https://qnoeiurmyyyuawkcifmw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service / secret key (sb_secret_… or legacy service_role JWT): webhook + discount redeem only.
SUPABASE_SERVICE_ROLE_KEY=

# App origin for Stripe redirect URLs (Checkout success/cancel, Portal return).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# P6f / P12 billing (server-only; never expose with NEXT_PUBLIC_).
# Stripe never receives encryption keys or encrypted content, only billing metadata.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro Workspace yearly Price.
STRIPE_PRICE_PRO_WORKSPACE_YEARLY=
# Capacity Increase yearly Price (same billing interval as Pro Workspace).
STRIPE_PRICE_PRO_WORKSPACE_CAPACITY_INCREASE_YEARLY=

