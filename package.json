{
  "name": "helvety-cloud",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter web dev",
    "build": "bun run --filter web build",
    "lint": "bun run --filter web lint && eslint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@helvety-cloud/api-contract": "workspace:*",
    "@helvety-cloud/crypto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
