# Supabase project: helvety-cloud
# Ref: qnoeiurmyyyuawkcifmw (Zurich / eu-central-2)
# Forbidden: old helvety project bkdzeihxzvrkndjvyzye — do not use.
#
# Copy to apps/web/.env.local for local Next.js (never commit secrets).

NEXT_PUBLIC_SUPABASE_URL=https://qnoeiurmyyyuawkcifmw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App origin for Stripe redirect URLs (Checkout success/cancel, Portal return).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# P6f billing (server-only; never expose with NEXT_PUBLIC_).
# Stripe never receives vault keys or vault content — billing metadata only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the "Helvety Pro" monthly price (create in Stripe Dashboard).
STRIPE_PRICE_PRO_MONTHLY=
# Service role: used ONLY by /api/webhooks/stripe to upsert billing rows.
SUPABASE_SERVICE_ROLE_KEY=
